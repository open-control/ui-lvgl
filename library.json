{
  "name": "oc-ui-lvgl",
  "version": "0.2.0",
  "description": "LVGL UI integration for Open Control Framework",
  "keywords": ["open-control", "lvgl", "ui", "embedded", "display"],
  "repository": {
    "type": "git",
    "url": "https://github.com/open-control/ui-lvgl.git"
  },
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "dependencies": {
    "lvgl/lvgl": "9.5.0"
  },
  "build": {
    "includeDir": "src",
    "flags": [
      "-D LV_CONF_INCLUDE_SIMPLE",
      "-D LV_LVGL_H_INCLUDE_SIMPLE"
    ],
    "srcFilter": [
      "+<oc/ui/lvgl/Bridge.cpp>",
      "+<oc/ui/lvgl/FontLoader.cpp>",
      "+<oc/ui/lvgl/FontUtils.cpp>",
      "+<oc/ui/lvgl/PausableTimer.cpp>",
      "+<oc/ui/lvgl/RetainedSurfaceParkingLot.cpp>",
      "+<oc/ui/lvgl/Screen.cpp>",
      "+<oc/ui/lvgl/SdlBridge.cpp>",
      "+<oc/ui/lvgl/StaticSurfaceInvalidation.cpp>"
    ]
  }
}
